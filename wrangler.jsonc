{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "atlas-content-factory",

  "main": "src/index.js",

  "compatibility_date": "2026-08-14",

  // =========================================================
  // 🤖 CLOUDFLARE WORKERS AI
  // =========================================================

  "ai": {
    "binding": "AI"
  },

  // =========================================================
  // 🧠 ATLAS MEMORY — KV
  // =========================================================

  "kv_namespaces": [
    {
      "binding": "ATLAS_KV",
      "id": "KV_NAMESPACE_ID"
    }
  ],

  // =========================================================
  // 🔐 VARIABLES / SECRETS
  // =========================================================

  /*
   * Secrets مثل:
   *
   * TELEGRAM_BOT_TOKEN
   * OPENAI_API_KEY
   *
   * داخل Cloudflare Dashboard تنظیم می‌شوند.
   *
   * مقدار Secret را داخل این فایل قرار نمی‌دهیم.
   */

  // =========================================================
  // ⚙️ OBSERVABILITY
  // =========================================================

  "observability": {
    "enabled": true
  }
}
