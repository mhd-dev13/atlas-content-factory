{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "atlas-content-factory",

  "main": "src/index.js",

  "compatibility_date": "2026-08-14",

  // =========================================================
  // 🤖 CLOUDFLARE WORKERS AI
  // =========================================================

  "ai": {
    "binding": "AI"
  },

  // =========================================================
  // 🧠 ATLAS MEMORY — KV
  // =========================================================

  "kv_namespaces": [
    {
      "binding": "ATLAS_KV",
      "id": "0050ce2896bd46e48d19743392bb5dac"
    }
  ],

  // =========================================================
  // 🛡️ GAME CONNECT DIAGNOSTIC RATE LIMIT
  // 10 requests per minute per client key (Cloudflare location-local).
  // =========================================================
  "ratelimits": [
    {
      "name": "DIAGNOSTIC_LIMITER",
      "namespace_id": "20261013",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  // =========================================================
  // ⚙️ OBSERVABILITY
  // =========================================================

  "observability": {
    "enabled": true
  }
}
